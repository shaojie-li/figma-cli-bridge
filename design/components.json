{
  "version": "1.0.0",
  "contracts": {
    "Actions/Button": {
      "axes": {"Intent":["Primary","Secondary","Danger"],"Size":["Sm","Md","Lg"],"State":["Rest","Hover","Pressed","Disabled","Loading"],"Focus":["False","True"]},
      "defaults": {"Intent":"Primary","Size":"Md","State":"Rest","Focus":"False"},
      "properties": {"Label":"TEXT","ShowLeadingIcon":"BOOLEAN"},
      "coverEach": ["Intent","Size","State","Focus"],
      "requiredPairs": [{"State":"Loading","Focus":"True"},{"Intent":"Danger","State":"Hover"},{"Intent":"Danger","State":"Disabled"}],
      "forbidden": [{"State":"Disabled","Focus":"True"}],
      "manual": ["Loading 保持宽度和可访问名称，阻止重复提交；保留触发前焦点", "长标签与图标光学居中", "成功/失败反馈属于操作结果，不伪造为按钮 Hover 状态"]
    },
    "Forms/Input": {
      "axes": {"Size":["Sm","Md","Lg"],"State":["Rest","Hover","Disabled","ReadOnly"],"Validation":["None","Error","Warning","Success"],"Content":["Empty","Filled"],"Focus":["False","True"]},
      "defaults": {"Size":"Md","State":"Rest","Validation":"None","Content":"Empty","Focus":"False"},
      "properties": {"Value":"TEXT","Placeholder":"TEXT","Message":"TEXT"},
      "coverEach": ["Size","State","Validation","Content","Focus"],
      "requiredPairs": [{"Validation":"Error","Focus":"True"},{"Validation":"Warning","Focus":"True"},{"State":"ReadOnly","Content":"Filled"},{"State":"Disabled","Content":"Filled"}],
      "forbidden": [{"State":"Disabled","Focus":"True"},{"State":"Disabled","Validation":"Error"},{"State":"Disabled","Validation":"Warning"},{"State":"Disabled","Validation":"Success"}],
      "manual": ["错误与警告有文字/图标提示，不能只靠颜色", "空值、占位文本、只读和禁用可区分", "验证消息换行不覆盖相邻字段"]
    },
    "Forms/Checkbox": {
      "axes": {"Checked":["Unchecked","Checked","Indeterminate"],"State":["Rest","Hover","Pressed","Disabled"],"Validation":["None","Error"],"Focus":["False","True"]},
      "defaults": {"Checked":"Unchecked","State":"Rest","Validation":"None","Focus":"False"},
      "properties": {"Label":"TEXT"},
      "coverEach": ["Checked","State","Validation","Focus"],
      "requiredPairs": [{"Checked":"Checked","State":"Disabled"},{"Checked":"Indeterminate","State":"Disabled"},{"Validation":"Error","Focus":"True"}],
      "forbidden": [{"State":"Disabled","Focus":"True"}],
      "manual": ["多行标签按首行对齐，点击区域含标签", "Checked 与 Disabled 独立；禁用后保留选中标记", "基础组件透明外层，任务完成删除线属于业务组合"]
    },
    "Feedback/Alert": {
      "axes": {"Tone":["Info","Success","Warning","Error"]},
      "defaults": {"Tone":"Info"},
      "properties": {"Title":"TEXT","Description":"TEXT","Dismissible":"BOOLEAN"},
      "coverEach": ["Tone"], "requiredPairs": [], "forbidden": [],
      "manual": ["长消息、多行、关闭动作、可选操作；图标与文字共同传达语义"]
    },
    "Patterns/ContentState": {
      "axes": {"State":["Loading","Empty","NoResults","Error","Offline","Forbidden","Ready"]},
      "defaults": {"State":"Ready"},
      "properties": {"Title":"TEXT","Description":"TEXT"},
      "coverEach": ["State"], "requiredPairs": [], "forbidden": [],
      "manual": ["Empty 是尚无内容；NoResults 是筛选无结果，操作文案不同", "Loading 不短暂显示 Empty；错误保留已有内容和恢复入口", "需要对应能力时才接入 Offline/Forbidden，不虚构产品功能"]
    }
  }
}
