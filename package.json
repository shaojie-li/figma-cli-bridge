{
  "name": "figma-local-bridge",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "test:zip": "python3 scripts/verify-zip-install.py",
    "colors:export": "node scripts/export-colors.mjs",
    "layout:export": "node scripts/export-layout.mjs",
    "typography:export": "node scripts/export-typography.mjs",
    "build:community": "node scripts/build.mjs --community",
    "build": "node scripts/build.mjs",
    "start": "node src/cli.mjs serve",
    "test": "node --test test/*.test.mjs",
    "cli": "node src/cli.mjs"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
